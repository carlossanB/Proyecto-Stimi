# ==============================================================================
# VARIABLES DE ENTORNO DE PRODUCCIÓN - STIMI BACKEND (NESTJS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP & SEGURIDAD
# ------------------------------------------------------------------------------
PORT=3000
FRONTEND_URL=https://stimi.online,http://localhost:5173
JWT_SECRET=reemplazar_con_un_secreto_jwt_largo_y_robusto_en_produccion

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (POSTGRESQL)
# ------------------------------------------------------------------------------
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=stimi
DB_PASSWORD=reemplazar_con_contrasena_segura_db
DB_NAME=proyecto_formativo
DB_SYNCHRONIZE=false

# ------------------------------------------------------------------------------
# 3. SERVICIO DE CORREO ELECTRÓNICO (SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_app_password_de_gmail
MAIL_FROM_NAME=Stimi SENA

# ------------------------------------------------------------------------------
# 4. SEGURIDAD DE WEBHOOKS INBOUND (n8n / Bot -> NestJS)
# Header esperado en peticiones entrantes: x-webhook-key
# ------------------------------------------------------------------------------
WEBHOOK_HENRY_KEY=reemplazar_con_clave_secreta_webhook_inbound

# ------------------------------------------------------------------------------
# 5. ASISTENTE INTELIGENCIA ARTIFICIAL (OPENAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-tu_api_key_de_openai_aqui

# ------------------------------------------------------------------------------
# 6. INTEGRACIONES CON N8N (OUTBOUND: NestJS -> n8n)
# ------------------------------------------------------------------------------
# Notificación de eventos/acciones desde la web hacia n8n
N8N_WEBHOOK_PAGINA=https://n8n.tu-dominio.com/webhook/accion-pagina
N8N_WEBHOOK_KEY=reemplazar_con_token_webhook_pagina

# Validación de informes PDF (GC/GF) enviados a n8n
N8N_WEBHOOK_VALIDAR=https://n8n.tu-dominio.com/webhook/validar-informe-web
N8N_WEBHOOK_VALIDAR_KEY=reemplazar_con_token_webhook_validar

# Chat de soporte al coordinador hacia n8n
N8N_WEBHOOK_COORDINADOR=https://n8n.tu-dominio.com/webhook/chat-coordinador-web
N8N_WEBHOOK_COORDINADOR_KEY=reemplazar_con_token_webhook_coordinador